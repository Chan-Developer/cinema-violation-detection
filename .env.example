# Flask配置
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=cinema_detection

# 如果使用Docker运行MySQL，则设置为：
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=cinema_user
# DB_PASSWORD=cinema_pass123
# DB_NAME=cinema_detection

# LLM 配置 (选择一个提供商)
# 可选值: openai, zhipu, qwen, modelscope
LLM_PROVIDER=modelscope

# ModelScope API Key (推荐使用)
# ModelScope: https://modelscope.cn/my/myaccount/tokens
MODELSCOPE_API_KEY=your_modelscope_api_key

# OpenAI API Key (可选)
OPENAI_API_KEY=your_openai_api_key

# 智谱AI API Key (可选)
ZHIPU_API_KEY=your_zhipu_api_key

# DashScope (通义千问) API Key (可选)
DASHSCOPE_API_KEY=your_dashscope_api_key

# YOLO 配置
# YOLO 模型路径 (支持: yolov8n, yolov8s, yolov8m, yolov8l, yolov8x)
YOLO_MODEL_PATH=yolov8x.pt

# YOLO 使用设备 (cpu 或 cuda，如果有 GPU)
YOLO_DEVICE=cpu
# YOLO_DEVICE=cuda  # 取消注释以使用 GPU

# 启用 YOLO 检测
ENABLE_YOLO=true

# YOLO 置信度阈值 (0-1, 越高越严格)
YOLO_CONFIDENCE=0.5
